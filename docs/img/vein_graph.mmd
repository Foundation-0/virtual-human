%% Lower-limb venous flow graph (standing)
flowchart BT
  ra["ra"]
  ivc["ivc"]
  iliac["iliac"]
  femoral["femoral"]
  popliteal["popliteal"]
  calf["calf"]
  ankle["ankle"]
  foot["foot"]
  saphenous["saphenous"]
  foot -->|"0.50 L/min"| ankle
  ankle -->|"0.46 L/min"| calf
  calf -->|"0.46 L/min"| popliteal
  popliteal -->|"0.46 L/min"| femoral
  femoral -->|"0.50 L/min"| iliac
  iliac -->|"0.50 L/min"| ivc
